+                &instrument,
+                UnixNanos::from(timestamp * 1_000_000),
+            )
+            .unwrap();
+            assert_eq!(deltas.deltas[0].action, BookAction::Clear);
+            assert_ne!(deltas.deltas[0].flags & RecordFlag::F_SNAPSHOT as u8, 0);
+            assert_ne!(
