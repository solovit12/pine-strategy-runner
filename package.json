{
  "name": "pine-strategy-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "overrides": {
    "dompurify": "3.4.14"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-pinets-build.mjs",
    "ensure:pinets": "node scripts/ensure-pinets-build.mjs",
    "prebuild": "npm run ensure:pinets",
    "predev": "npm run ensure:pinets",
    "predev:api": "npm run ensure:pinets",
    "prestart": "npm run ensure:pinets",
    "pretest": "npm run ensure:pinets",
    "pretypecheck": "npm run ensure:pinets",
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run clean && npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/server/apps/api/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "qualify:paper": "tsx scripts/qualify-nautilus-paper-api.ts --five-markets --fast-book"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@monaco-editor/react": "4.7.0",
    "fastify": "5.12.3",
    "lightweight-charts": "5.2.1",
    "lossless-json": "4.3.1",
    "lucide-react": "1.41.0",
    "monaco-editor": "0.56.0",
    "pinets": "file:vendor/pinets",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
