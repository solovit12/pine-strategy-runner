//@version=6
strategy("Q07 Pyramiding", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=0.01,
     pyramiding=3, commission_type=strategy.commission.percent,
     commission_value=0.1, slippage=0, process_orders_on_close=false)

int START_TIME = timestamp("UTC", 2026, 6, 1, 0, 0)
int END_TIME = timestamp("UTC", 2026, 9, 1, 0, 0)
bool inWindow = time >= START_TIME and time < END_TIME
bool afterWindow = time >= END_TIME

float trendSma = ta.sma(close, 20)
bool addSignal = close > trendSma and bar_index % 24 == 0
bool exitSignal = ta.crossunder(close, trendSma)

if inWindow and addSignal
    strategy.entry("Pyramid", strategy.long)

if inWindow and exitSignal and strategy.position_size > 0
    strategy.close("Pyramid", comment="Trend exit")

if afterWindow and strategy.position_size != 0
    strategy.close_all(comment="Window end")

plot(trendSma, "SMA 20", color=color.orange)

