// Test-only date gate added for an exact TradingView Essential comparison.

//@version=5
strategy('Highest High and Lowest Low Channel Strategy — validation', overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=0.01,
     pyramiding=1,
     commission_type=strategy.commission.percent, commission_value=0.045,
     slippage=0, margin_long=0, margin_short=0,
     calc_on_order_fills=false, calc_on_every_tick=false,
     process_orders_on_close=false, use_bar_magnifier=false)

length = input.int(20)
reverse = input.bool(false, title='Trade reverse')

int START_TIME = timestamp('UTC', 2026, 9, 10, 0, 0)
int END_TIME = timestamp('UTC', 2026, 9, 18, 0, 0)
bool inWindow = time >= START_TIME and time < END_TIME

var int firstWindowBar = na
if inWindow and na(firstWindowBar)
    firstWindowBar := bar_index

// On the first 20 bars we only warm up HH/LL, exactly like the isolated local run.
bool ready = inWindow and not na(firstWindowBar) and bar_index - firstWindowBar >= length
// An order created on the final bar would fill outside the local data window.
bool canPlaceOrder = ready and time_close < END_TIME

hh = ta.highest(high, length)
ll = ta.lowest(low, length)

pos = 0.0
if ready
    iff_1 = close < ll[1] ? -1 : nz(pos[1], 0)
    pos := close > hh[1] ? 1 : iff_1
else
    pos := 0

iff_2 = reverse and pos == -1 ? 1 : pos
possig = reverse and pos == 1 ? -1 : iff_2

if canPlaceOrder and possig == 1
    strategy.entry('Long', strategy.long)
if canPlaceOrder and possig == -1
    strategy.entry('Short', strategy.short)

barcolor(possig == -1 ? color.red : possig == 1 ? color.green : color.blue)
plot(inWindow ? hh[1] : na, color=color.new(color.green, 0), title='HH', linewidth=2)
plot(inWindow ? ll[1] : na, color=color.new(color.red, 0), title='LL', linewidth=2)
